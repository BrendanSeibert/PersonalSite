# DEVELOPMENT VALUES ONLY. Never reuse these on a server or for any real data.
# The password goes inside a URL (see below), so use only letters, numbers, - and _ in it.
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=app
BACKEND_PORT=3000
# The visitor cookie's Secure flag: false for http://localhost; set to true on any server reached over HTTPS.
COOKIE_SECURE=false
# How many reverse proxies sit in front of the backend. 0 on your machine. Usually 1 on a host,
# but check it there (README, "Security").
TRUST_PROXY=0
# Set only in the production image: the folder with the built frontend. Leave unset here.
# STATIC_DIR=/app/public
# On a host, DATABASE_URL ends with ?sslmode=verify-full unless it uses the host's private network.
# Never sslmode=require or no-verify. For a provider with its own certificate authority, leave sslmode
# out and put the authority's PEM text in DATABASE_CA_CERT instead. Only when the database is on the
# host's private network, and so has no sslmode, set DATABASE_PRIVATE_NETWORK=true: production refuses
# a plain-text database connection otherwise.
# DATABASE_PRIVATE_NETWORK=true
# Signs the visitor cookie. Leave unset here (a development key is used). Required in production, and
# only for docker-compose.prod.yml in this file: your own value from `openssl rand -base64 48`.
# VISITOR_SECRET=
