{
  "name": "backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --legacy-watch --signal SIGTERM --watch src --ext ts --exec tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "compression": "1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
